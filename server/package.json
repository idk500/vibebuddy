{
  "name": "vibe-companion-server",
  "version": "0.1.0",
  "description": "VibeBuddy Relay Server — bridges AI coding tool events to companion displays",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "verify:stats": "node scripts/verify-stats-events.mjs",
    "verify:pwa-stats": "node ../app/scripts/verify-legacy-stats.mjs",
    "verify:firefox-stats": "node ../app/scripts/verify-firefox-stats.mjs",
    "e2e:firefox-opencode": "node ../app/scripts/e2e-firefox-opencode-run.mjs",
    "e2e:firefox-opencode-approval": "node ../app/scripts/e2e-firefox-opencode-tool-approval.mjs",
    "e2e:firefox-relay-prompt": "node ../app/scripts/e2e-firefox-relay-prompt.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.15.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
