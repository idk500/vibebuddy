{
  "name": "vibe-companion-server",
  "version": "0.1.0",
  "description": "VibeCoding Companion Relay Server — bridges OpenCode events to phone PWA",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
